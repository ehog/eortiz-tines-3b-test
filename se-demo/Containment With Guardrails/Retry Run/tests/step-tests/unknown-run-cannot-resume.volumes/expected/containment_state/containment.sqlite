__3B_STEP_TEST_SQLITE_DUMP__
PRAGMA foreign_keys=OFF;
BEGIN TRANSACTION;
CREATE TABLE runs (
  id TEXT PRIMARY KEY,
  created_at TEXT NOT NULL,
  updated_at TEXT NOT NULL,
  alert_id TEXT NOT NULL,
  endpoint TEXT NOT NULL,
  user_email TEXT NOT NULL,
  severity TEXT NOT NULL,
  status TEXT NOT NULL,
  chaos TEXT NOT NULL,
  ticket_number TEXT,
  ticket_sys_id TEXT,
  ticket_state TEXT,
  isolation_state TEXT,
  failed_stage TEXT,
  failure_reason TEXT,
  failure_class TEXT,
  guardrail TEXT,
  safe_to_retry INTEGER NOT NULL DEFAULT 0,
  resume_count INTEGER NOT NULL DEFAULT 0,
  started_at TEXT,
  finished_at TEXT
);
CREATE TABLE run_stages (
  run_id TEXT NOT NULL,
  stage TEXT NOT NULL,
  position INTEGER NOT NULL,
  status TEXT NOT NULL,
  attempts INTEGER NOT NULL DEFAULT 0,
  started_rel_ms INTEGER,
  duration_ms INTEGER,
  timeout_ms INTEGER,
  max_retries INTEGER,
  status_code INTEGER,
  classification TEXT,
  request_key TEXT,
  detail TEXT,
  result TEXT,
  updated_at TEXT NOT NULL,
  PRIMARY KEY (run_id, stage)
);
CREATE TABLE attempt_log (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  run_id TEXT NOT NULL,
  ts TEXT NOT NULL,
  rel_ms INTEGER NOT NULL,
  stage TEXT NOT NULL,
  attempt INTEGER NOT NULL,
  event TEXT NOT NULL,
  level TEXT NOT NULL,
  outcome TEXT NOT NULL,
  status_code INTEGER,
  classification TEXT,
  latency_ms INTEGER,
  message TEXT NOT NULL,
  payload TEXT NOT NULL
);
CREATE TABLE audit_log (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  run_id TEXT NOT NULL,
  ts TEXT NOT NULL,
  rel_ms INTEGER NOT NULL,
  actor TEXT NOT NULL,
  stage TEXT NOT NULL,
  action TEXT NOT NULL,
  target TEXT NOT NULL,
  request_key TEXT,
  attempt INTEGER,
  outcome TEXT NOT NULL,
  status_code INTEGER,
  classification TEXT,
  latency_ms INTEGER,
  detail TEXT NOT NULL
);
CREATE TABLE mock_state (
  key TEXT PRIMARY KEY,
  value TEXT NOT NULL
);
DELETE FROM sqlite_sequence;
CREATE INDEX attempt_log_run ON attempt_log (run_id, id);
CREATE INDEX audit_log_run ON audit_log (run_id, id);
COMMIT;
