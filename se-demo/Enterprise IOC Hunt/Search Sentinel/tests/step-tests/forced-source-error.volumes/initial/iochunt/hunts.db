CREATE TABLE hunts (id TEXT PRIMARY KEY, reason TEXT NOT NULL, demo_mode TEXT NOT NULL, created_at TEXT NOT NULL, status TEXT NOT NULL, approval_token TEXT NOT NULL, combined_at TEXT, report_json TEXT, sn_number TEXT, sn_sys_id TEXT, sn_created_at TEXT, findings_path TEXT);
CREATE TABLE indicators (hunt_id TEXT NOT NULL, value TEXT NOT NULL, type TEXT NOT NULL, position INTEGER NOT NULL, PRIMARY KEY (hunt_id, value));
CREATE TABLE source_results (hunt_id TEXT NOT NULL, source TEXT NOT NULL, indicator TEXT NOT NULL, status TEXT NOT NULL, error_reason TEXT, findings_json TEXT, first_seen TEXT, last_seen TEXT, frequency INTEGER NOT NULL DEFAULT 0, created_at TEXT NOT NULL, PRIMARY KEY (hunt_id, source, indicator));
CREATE TABLE block_requests (hunt_id TEXT PRIMARY KEY, requested_at TEXT NOT NULL, slack_channel TEXT, slack_message TEXT, slack_ts TEXT, slack_error TEXT, targets_json TEXT, decision TEXT, decided_at TEXT, approver TEXT, executed_at TEXT, results_json TEXT);
