{
  "get": {
    "summary": "Everything the Data Operations Console renders, in one read-only payload",
    "parameters": [
      {
        "name": "limit",
        "in": "query",
        "required": false,
        "description": "How many recent runs to return (max 100, default 25).",
        "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 25 }
      }
    ],
    "responses": {
      "200": {
        "description": "Console payload. Returns an empty but well-formed payload when the store has no runs yet.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["ok", "generatedAt", "runs", "health", "rejectionBreakdown", "quarantine", "remediations"],
              "properties": {
                "ok": { "type": "boolean" },
                "generatedAt": { "type": "string", "format": "date-time" },
                "health": {
                  "type": "object",
                  "properties": {
                    "lastRunStatus": { "type": "string", "enum": ["ok", "degraded", "failed", "running", "stalled", "none"] },
                    "lastRunId": { "type": ["string", "null"] },
                    "lastRunAt": { "type": ["string", "null"], "format": "date-time" },
                    "publishedLast24h": { "type": "integer" },
                    "totalPublished": { "type": "integer" },
                    "openQuarantines": { "type": "integer" },
                    "qualityTrend": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "runId": { "type": "string" },
                          "startedAt": { "type": "string", "format": "date-time" },
                          "score": { "type": "number" },
                          "status": { "type": "string" }
                        }
                      }
                    }
                  }
                },
                "runs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "runId": { "type": "string" },
                      "batchId": { "type": "string" },
                      "chaos": { "type": "string" },
                      "startedAt": { "type": "string", "format": "date-time" },
                      "finishedAt": { "type": ["string", "null"], "format": "date-time" },
                      "durationMs": { "type": ["integer", "null"] },
                      "status": { "type": "string", "enum": ["ok", "degraded", "failed", "running", "stalled"] },
                      "sources": { "type": "array", "items": { "type": "string" } },
                      "recordsIn": { "type": "integer" },
                      "recordsOut": { "type": "integer" },
                      "duplicates": { "type": "integer" },
                      "rejected": { "type": "integer" },
                      "quarantined": { "type": "integer" },
                      "qualityScore": { "type": ["number", "null"] },
                      "error": {
                        "type": ["object", "null"],
                        "properties": {
                          "source": { "type": "string" },
                          "field": { "type": ["string", "null"] },
                          "recordId": { "type": ["string", "null"] },
                          "message": { "type": "string" },
                          "changedVsLastGoodRun": { "type": ["string", "null"] },
                          "owner": { "type": "string" }
                        }
                      },
                      "triage": {
                        "type": ["object", "null"],
                        "properties": {
                          "rootCause": { "type": "string" },
                          "confidence": { "type": "string" },
                          "note": { "type": "string" },
                          "model": { "type": "string" },
                          "owner": { "type": "string" },
                          "generatedAt": { "type": "string", "format": "date-time" },
                          "proposedFix": {
                            "type": ["object", "null"],
                            "properties": {
                              "kind": { "type": "string" },
                              "source": { "type": "string" },
                              "fromField": { "type": "string" },
                              "toField": { "type": "string" },
                              "description": { "type": "string" }
                            }
                          }
                        }
                      },
                      "timeline": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "step": { "type": "string" },
                            "durationMs": { "type": "integer" },
                            "lines": { "type": "integer" }
                          }
                        }
                      },
                      "logs": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "step": { "type": "string" },
                            "ts": { "type": "string", "format": "date-time" },
                            "durationMs": { "type": ["integer", "null"] },
                            "level": { "type": "string", "enum": ["info", "warn", "error"] },
                            "message": { "type": "string" },
                            "data": { "type": ["object", "null"] }
                          }
                        }
                      },
                      "rejectionsByReason": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "reasonCode": { "type": "string" },
                            "count": { "type": "integer" }
                          }
                        }
                      }
                    }
                  }
                },
                "rejectionBreakdown": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "reasonCode": { "type": "string" },
                      "count": { "type": "integer" }
                    }
                  }
                },
                "quarantine": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "type": "integer" },
                      "runId": { "type": "string" },
                      "trialId": { "type": "string" },
                      "ndc": { "type": "string" },
                      "reasonCode": { "type": "string" },
                      "detail": { "type": "string" },
                      "matchedField": { "type": "string" },
                      "source": { "type": "string" },
                      "status": { "type": "string", "enum": ["open", "released", "dismissed"] },
                      "decidedAt": { "type": ["string", "null"], "format": "date-time" },
                      "decidedBy": { "type": ["string", "null"] }
                    }
                  }
                },
                "remediations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "source": { "type": "string" },
                      "fromField": { "type": "string" },
                      "toField": { "type": "string" },
                      "approvedAt": { "type": "string", "format": "date-time" },
                      "approvedBy": { "type": "string" },
                      "runId": { "type": ["string", "null"] }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
