__3B_STEP_TEST_SQLITE_DUMP__
PRAGMA foreign_keys=OFF;
BEGIN TRANSACTION;
CREATE TABLE config (id INTEGER PRIMARY KEY CHECK (id = 1), json TEXT NOT NULL);
CREATE TABLE demo_clock (id INTEGER PRIMARY KEY CHECK (id = 1), mode TEXT NOT NULL, updated_at TEXT NOT NULL);
CREATE TABLE critical_assets (hostname TEXT PRIMARY KEY, tier TEXT NOT NULL, owner TEXT NOT NULL, business_service TEXT NOT NULL, business_impact TEXT NOT NULL, notes TEXT NOT NULL DEFAULT '');
CREATE TABLE alerts (
  id TEXT PRIMARY KEY,
  source TEXT NOT NULL,
  received_at TEXT NOT NULL,
  title TEXT NOT NULL,
  severity TEXT NOT NULL,
  confidence TEXT NOT NULL,
  user_name TEXT,
  host TEXT,
  indicator TEXT,
  json TEXT NOT NULL
);
CREATE TABLE gate_decisions (
  alert_id TEXT PRIMARY KEY,
  decided_at TEXT NOT NULL,
  decision TEXT NOT NULL,
  score REAL NOT NULL,
  threshold REAL NOT NULL,
  after_hours INTEGER NOT NULL,
  clock_mode TEXT NOT NULL,
  reason TEXT NOT NULL,
  breakdown TEXT NOT NULL,
  replayed INTEGER NOT NULL DEFAULT 0
);
CREATE TABLE deferred_queue (
  alert_id TEXT PRIMARY KEY,
  queued_at TEXT NOT NULL,
  score REAL NOT NULL,
  reason TEXT NOT NULL,
  digested_at TEXT
);
CREATE TABLE paged_events (
  id TEXT PRIMARY KEY,
  alert_id TEXT NOT NULL,
  created_at TEXT NOT NULL,
  status TEXT NOT NULL,
  on_call TEXT NOT NULL,
  score REAL NOT NULL,
  payload TEXT NOT NULL,
  slack_channel TEXT,
  slack_ts TEXT,
  slack_error TEXT,
  acked_at TEXT,
  resolved_at TEXT
);
CREATE TABLE digests (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  created_at TEXT NOT NULL,
  status TEXT NOT NULL,
  window_start TEXT,
  window_end TEXT,
  item_count INTEGER NOT NULL DEFAULT 0,
  markdown TEXT NOT NULL DEFAULT '',
  html TEXT NOT NULL DEFAULT '',
  slack_text TEXT NOT NULL DEFAULT '',
  json TEXT NOT NULL DEFAULT '{}',
  email_status TEXT,
  slack_status TEXT
);
CREATE TABLE timeline (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  at TEXT NOT NULL,
  kind TEXT NOT NULL,
  message TEXT NOT NULL,
  meta TEXT NOT NULL DEFAULT '{}'
);
