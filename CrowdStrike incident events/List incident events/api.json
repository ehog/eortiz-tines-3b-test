{
  "get": {
    "operationId": "listCrowdStrikeIncidentEvents",
    "summary": "List recent CrowdStrike cases and their evidence events",
    "parameters": [
      {
        "name": "limit",
        "in": "query",
        "required": false,
        "description": "How many of the most recently created cases to return. Defaults to 25.",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 25
        }
      }
    ],
    "responses": {
      "200": {
        "description": "Recent cases with nested evidence events. Falcon cases replaced the retired Incidents API.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["total", "incidents"],
              "properties": {
                "total": {
                  "type": "integer",
                  "description": "Total cases matching the query in CrowdStrike, which may exceed the returned page."
                },
                "incidents": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "type": ["string", "null"] },
                      "reference_id": { "type": ["string", "null"] },
                      "name": { "type": ["string", "null"] },
                      "status": { "type": ["string", "null"] },
                      "severity": { "type": ["number", "null"] },
                      "severity_level": { "type": ["string", "null"] },
                      "description": { "type": ["string", "null"] },
                      "created_timestamp": { "type": ["string", "null"] },
                      "updated_timestamp": { "type": ["string", "null"] },
                      "start_timestamp": { "type": ["string", "null"] },
                      "end_timestamp": { "type": ["string", "null"] },
                      "assigned_to": { "type": ["string", "null"] },
                      "tags": { "type": "array", "items": { "type": "string" } },
                      "events": {
                        "type": "array",
                        "items": { "type": "object" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
